# ============================================================
# 开发环境配置模板
# 复制此文件为 application-dev.yml 并填入真实值
# cp application-dev.yml.example application-dev.yml
# ============================================================

spring:
  datasource:
    url: jdbc:mysql://${DEV_DB_HOST}:${DEV_DB_PORT:3306}/${DEV_DB_NAME}?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
    username: ${DEV_DB_USER:}
    password: ${DEV_DB_PASSWORD:}
    driver-class-name: com.mysql.cj.jdbc.Driver

  data:
    redis:
      host: ${DEV_REDIS_HOST}
      port: ${DEV_REDIS_PORT:6379}
      username: ${DEV_REDIS_USERNAME:}
      database: ${DEV_REDIS_DATABASE:1}
      password: ${DEV_REDIS_PASSWORD:}

mybatis-plus:
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl
  global-config:
    db-config:
      logic-delete-field: deleted
      logic-delete-value: 1
      logic-not-delete-value: 0

knife4j:
  enable: true

logging:
  level:
    com.spacetime: DEBUG

dev-fixed-login:
  enabled: ${DEV_FIXED_LOGIN_ENABLED:true}
  token: ${DEV_FIXED_LOGIN_TOKEN:}
  phone: ${DEV_FIXED_LOGIN_PHONE:}

oss:
  endpoint: ${DEV_OSS_ENDPOINT:https://oss-cn-shanghai.aliyuncs.com}
  access-key-id: ${DEV_OSS_ACCESS_KEY_ID:}
  access-key-secret: ${DEV_OSS_ACCESS_KEY_SECRET:}
  bucket-name: ${DEV_OSS_BUCKET_NAME:shikongxiehou}
  cdn-domain: ${DEV_OSS_CDN_DOMAIN:}
  url-expire-seconds: ${DEV_OSS_URL_EXPIRE_SECONDS:300}

wechat-pay:
  app-id: <微信 AppID>
  mch-id: '<商户号>'
  api-v3-key: <API v3 密钥>
  cert-serial-no: <证书序列号>
  private-key-path: cert/apiclient_key.pem
  merchant-cert-path: cert/apiclient_cert.pem
  notify-url: <支付回调地址>
  description-prefix: 时空邂逅
  test-amount: 0.01

commercial:
  vip-expiration:
    fixed-delay-ms: 60000
    initial-delay-ms: 10000

wechat-miniapp:
  app-id: ${DEV_WECHAT_MINIAPP_APP_ID:}
  app-secret: ${DEV_WECHAT_MINIAPP_APP_SECRET:}
