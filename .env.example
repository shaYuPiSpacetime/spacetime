# Spacetime 环境变量模板
# 复制此文件为 .env 并填入真实值，不要将 .env 提交到 Git

# 数据库
DB_HOST=localhost
DB_PORT=3306
DB_NAME=shikongxiehou
DB_USER=root
DB_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=1
REDIS_PASSWORD=

# 本地真实联调用，不要提交真实密码
API_URL=http://127.0.0.1:8080
ADMIN_ACCOUNT=
ADMIN_PASSWORD=

# 阿里云 OSS
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
