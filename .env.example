# Spacetime environment template.
# Copy to .env only when you intentionally want root-level shared env.
# For backend local development, prefer backend/.env.local.
# Never commit real secrets.

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=shikongxiehou
DB_USER=root
DB_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=1
REDIS_PASSWORD=

# Local integration smoke account
API_URL=http://127.0.0.1:8080
ADMIN_ACCOUNT=
ADMIN_PASSWORD=

# Aliyun OSS
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
